{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "adb-reverse",
      "type": "shell",
      "command": "adb reverse tcp:8000 tcp:8000 || true",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "start-backend",
      "type": "shell",
      "command": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
