{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DrivePlus (Flutter App)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "preLaunchTask": "adb-reverse"
    },
    {
      "name": "FastAPI Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Backend + Flutter)",
      "configurations": [
        "FastAPI Backend",
        "DrivePlus (Flutter App)"
      ],
      "stopAll": true
    }
  ]
}
